      "id": "29bc9015-9dbf-4826-be91-89256475577e",
      "name": "Normalizar Mensaje",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [224, 688],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\nconst body = $input.first().json.body || {};\nconst data = body.data;\nif (!data || !data.key) return [];\nif (data.key.fromMe) return [];\nconst remoteJid = data.key.remoteJid || '';\nif (remoteJid.endsWith('@g.us')) return [];\nconst texto = data.message && (data.message.conversation || (data.message.extendedTextMessage && data.message.extendedTextMessage.text));\nif (!texto) return [];\nconst telefono = remoteJid.split('@')[0];\nreturn [{ json: { telefono, texto, wa_message_id: data.key.id } }];\n"
      }
    },
