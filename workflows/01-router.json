    {
      "id": "a99df0da-0655-43a6-b858-5237cb06ea0d",
      "name": "Procesar Paso Registro",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1632, 48],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\nconst conv = $input.first().json;\nconst cliente = $('Buscar Cliente').first().json;\nconst contexto = conv.contexto || { paso: 'nombre_dueno', datos: {} };\nconst paso = contexto.paso || 'nombre_dueno';\nconst datos = contexto.datos || {};\nconst texto = (cliente.texto || '').trim();\n\nconst SINONIMOS_ESPECIE = {\n  perro: 'perro', perrito: 'perro', can: 'perro', cachorro: 'perro', dog: 'perro',\n  gato: 'gato', gatito: 'gato', michi: 'gato', felino: 'gato', cat: 'gato',\n  hamster: 'hamster', conejo: 'conejo', tortuga: 'tortuga', pez: 'pez',\n  loro: 'loro', canario: 'canario', iguana: 'iguana', caballo: 'caballo',\n  gallina: 'gallina', pato: 'pato', cerdo: 'cerdo', oveja: 'oveja', cabra: 'cabra'\n};\nconst ESPECIES_VALIDAS = ['perro','gato','hamster','caballo','conejo','huron','cobayo','chinchilla','loro','guacamayo','periquito','canario','cacatúa','ninfas','gallina','pato','ganso','paloma','búho','tortuga','iguana','vaca','toro','cerdo','oveja','cabra','llama','alpaca','pony','burro','mula','pez'];\n\nconst SINONIMOS_SEXO = {\n  macho: 'macho', male: 'macho', varon: 'macho', m: 'macho',\n  hembra: 'hembra', female: 'hembra', f: 'hembra'\n};\n\nfunction normaliza(s) {\n  return (s || '').toString().trim().toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g, '');\n}\n\nfunction esSaltear(s) {\n  const n = normaliza(s);\n  return n === 'no' || n === 'ninguna' || n === 'skip' || n === 'no se' || n === 'no importa';\n}\n\nlet siguientePaso = paso;\nlet mensaje = null;\nlet finalizar = false;\n\nif (paso === 'nombre_dueno') {\n  if (!texto) { mensaje = 'Decime tu nombre para continuar con el alta.'; }\n  else { datos.nombre_dueno = texto; siguientePaso = 'nombre_mascota'; mensaje = 'Gracias, ' + texto + '! Y como se llama tu mascota?'; }\n} else if (paso === 'nombre_mascota') {\n  if (!texto) { mensaje = 'Decime el nombre de tu mascota para continuar.'; }\n  else { datos.nombre_mascota = texto; siguientePaso = 'especie'; mensaje = 'Que especie es ' + texto + '? (perro, gato, etc.)'; }\n} else if (paso === 'especie') {\n  const n = normaliza(texto);\n  const match = SINONIMOS_ESPECIE[n] || (ESPECIES_VALIDAS.includes(n) ? n : null);\n  if (!match) { mensaje = 'No reconoci esa especie. Las mas comunes son: perro, gato, conejo, hamster, ave, tortuga. Cual es?'; }\n  else { datos.especie = match; siguientePaso = 'sexo'; mensaje = 'Es macho o hembra?'; }\n} else if (paso === 'sexo') {\n  const n = normaliza(texto);\n  const match = SINONIMOS_SEXO[n];\n  if (!match) { mensaje = 'No entendi. Respondeme \"macho\" o \"hembra\".'; }\n  else { datos.sexo = match; siguientePaso = 'raza'; mensaje = 'Sabes la raza? (si no sabes o no aplica, respondeme \"no\")'; }\n} else if (paso === 'raza') {\n  datos.raza = esSaltear(texto) ? null : texto;\n  finalizar = true;\n} else {\n  siguientePaso = 'nombre_dueno';\n  mensaje = 'Retomemos el alta. Decime tu nombre.';\n}\n\nif (finalizar) {\n  return [{ json: { accion: 'finalizar', datos, cliente_id: cliente.cliente_id, telefono: cliente.telefono } }];\n}\n\nreturn [{ json: { accion: 'preguntar', paso: siguientePaso, datos, mensaje, cliente_id: cliente.cliente_id, telefono: cliente.telefono } }];\n"
      }
    },
