    {
      "id": "a836e9ed-67f5-4bc3-821a-6fdb6f5ad024",
      "name": "Buscar Mascota y Historial",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [224, 256],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT m.id AS mascota_id, m.nombre AS mascota_nombre, m.especie::text AS especie, m.raza, m.fecha_nacimiento, m.peso, m.notas_generales, (m.id IS NOT NULL) AS tiene_mascota, COALESCE((SELECT json_agg(json_build_object('fecha', h.fecha, 'tipo', h.tipo::text, 'diagnostico', h.diagnostico, 'tratamiento', h.tratamiento_indicado) ORDER BY h.fecha DESC) FROM historias_clinicas h WHERE h.mascota_id = m.id), '[]'::json) AS historial FROM (SELECT $1::uuid AS cliente_id) c LEFT JOIN LATERAL (SELECT * FROM mascotas mm WHERE mm.cliente_id = c.cliente_id AND mm.estado = 'vivo' ORDER BY mm.created_at ASC LIMIT 1) m ON true",
        "options": { "queryReplacement": "={{ [$json.cliente_id] }}" }
      },
      "credentials": { "postgres": { "name": "Supabase Postgres" } }
    },
    {
      "id": "826d41f8-fc52-4f30-b118-08328cf82810",
      "name": "Tiene Mascota?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [448, 256],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [{ "leftValue": "={{ $json.tiene_mascota }}", "operator": { "type": "boolean", "operation": "equals" }, "rightValue": true }],
          "combinator": "and"
        }
      }
    },
    {
      "id": "26d829f1-7cb7-4547-a9b5-f6a707032612",
      "name": "Triaje de Sintomas",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [672, 0],
      "parameters": {
        "promptType": "define",
        "text": "={{ 'Mensaje del dueño: ' + $('Recibir Datos de Triaje').item.json.texto + '\\n\\nDatos de la mascota: ' + JSON.stringify({ nombre: $json.mascota_nombre, especie: $json.especie, raza: $json.raza, fecha_nacimiento: $json.fecha_nacimiento, peso: $json.peso, notas: $json.notas_generales }) + '\\n\\nHistorial clinico reciente (JSON, mas reciente primero): ' + JSON.stringify($json.historial) }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "Sos el asistente de triaje de una veterinaria. Clasificas el sintoma que describe el dueño en espanol rioplatense. Clasificacion posible: \"baja\" (cuidados en casa, sin urgencia), \"media\" (conviene un turno pronto pero no es una emergencia), \"alta\" (riesgo de vida o signos de alarma, requiere atencion inmediata). Ejemplos: \"vomito una vez y esta activo\" -> baja. \"diarrea hace 2 dias, come bien\" -> media. \"no puede respirar\", \"convulsion\", \"sangrado abundante\", \"no puede pararse\", \"hinchazon abdominal subita\" -> alta. Ante la duda entre dos niveles, elegi siempre el mas alto. Siempre completa los 4 campos: clasificacion, consejo (consejo practico y breve para el dueño, o el texto de derivacion si es alta), resumen_caso (resumen clinico breve en tercera persona para el registro), y razonamiento (por que elegiste esa clasificacion)."
        }
      }
    },
    {
      "id": "9d5d7a21-4526-4abb-8cc0-6084ab9a413b",
      "name": "Google Gemini - Triaje",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.1,
      "position": [688, 224],
      "parameters": { "modelName": "models/gemini-3.1-flash-lite", "options": { "temperature": 0.1 } },
      "credentials": { "googlePalmApi": { "name": "Google Gemini" } }
    },
    {
      "id": "501ad14a-ae0e-4085-b488-e92ef7f36f13",
      "name": "Parser Triaje",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [816, 224],
      "parameters": {
        "schemaType": "fromJson",
        "jsonSchemaExample": "{ \"clasificacion\": \"baja\", \"consejo\": \"Manten a tu mascota hidratada y en observacion por 24hs.\", \"resumen_caso\": \"Perro macho de 4 anios con vomitos aislados desde ayer, sin otros sintomas.\", \"razonamiento\": \"Vomitos aislados sin signos de alarma en un adulto sano sugieren cuadro leve autolimitado.\" }"
      }
    },
    {
      "id": "c5b4233c-8434-49a0-8619-e2b7821a1f49",
      "name": "Validar Clasificacion (Fail-safe)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1024, 112],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\nconst item = $input.first().json;\nconst salida = item.output || {};\nconst validas = ['baja', 'media', 'alta'];\nlet clasificacion = salida.clasificacion;\nlet consejo = salida.consejo;\nlet resumen_caso = salida.resumen_caso;\nlet razonamiento = salida.razonamiento;\n\nif (!validas.includes(clasificacion) || !consejo || !resumen_caso) {\n  clasificacion = 'alta';\n  consejo = 'No pude evaluar el sintoma con certeza. Por las dudas, te recomiendo contactar a la veterinaria cuanto antes.';\n  resumen_caso = (resumen_caso || ('Mensaje original: ' + $('Recibir Datos de Triaje').first().json.texto)) + ' [clasificacion forzada a alta por fallo de parseo del modelo]';\n  razonamiento = razonamiento || 'La respuesta del modelo no vino en el formato esperado; se escala por seguridad.';\n}\n\nreturn [{ json: { clasificacion, consejo, resumen_caso, razonamiento } }];\n"
      }
    },
    {
      "id": "6200316d-5190-478d-9a1a-c54d8bbc8342",
      "name": "Insertar Consulta",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [1248, 112],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO consultas (mascota_id, mensaje_original, clasificacion, consejo_generado) VALUES ($1, $2, $3, $4) RETURNING id",
        "options": { "queryReplacement": "={{ [$('Buscar Mascota y Historial').item.json.mascota_id, $('Recibir Datos de Triaje').item.json.texto, $json.clasificacion, $json.consejo] }}" }
      },
      "credentials": { "postgres": { "name": "Supabase Postgres" } }
    },
    {
      "id": "96fc117f-f4ab-426b-bf6c-a29c93f9a33b",
      "name": "Nivel de Urgencia",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.4,
      "position": [1472, 112],
      "parameters": {
        "rules": {
