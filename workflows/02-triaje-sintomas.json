                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
                "conditions": [{ "leftValue": "={{ $('Validar Clasificacion (Fail-safe)').item.json.clasificacion }}", "operator": { "type": "string", "operation": "equals" }, "rightValue": "alta" }],
                "combinator": "and"
              }
