  "name": "02 - Triaje de Sintomas",
  "nodes": [
    {
      "id": "553100b6-89e4-455c-82df-09b56e926510",
      "name": "Recibir Datos de Triaje",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.2,
      "position": [0, 256],
      "parameters": {
        "inputSource": "workflowInputs",
        "workflowInputs": {
          "values": [
