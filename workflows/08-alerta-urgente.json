      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [224, 0],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO alertas (consulta_id, mascota_id, cliente_id, resumen_caso) VALUES ($1, $2, $3, $4) RETURNING id",
        "options": {
          "queryReplacement": "={{ [$json.consulta_id, $json.mascota_id, $json.cliente_id, $json.resumen_caso] }}"
        }
      },
      "credentials": { "postgres": { "name": "Supabase Postgres" } }
    },
    {
      "id": "39b205d7-8362-4475-a069-8f24aaf2625d",
      "name": "Buscar Telefono Veterinario",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [448, 0],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT valor AS telefono_veterinario FROM configuracion_general WHERE clave = 'telefono_veterinario'"
      },
      "credentials": { "postgres": { "name": "Supabase Postgres" } }
    },
    {
      "id": "c1560b9c-8f13-46e4-9b4b-b726cf1ddec1",
