      "typeVersion": 3.5,
      "position": [672, 0],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "texto-alerta",
              "name": "texto",
              "value": "={{ '🚨 ALERTA URGENTE\\nCliente: ' + $('Recibir Datos de Alerta').item.json.cliente_id + '\\nResumen del caso: ' + $('Recibir Datos de Alerta').item.json.resumen_caso + '\\nRevisar y contactar al dueño lo antes posible.' }}",
              "type": "string"
            },
            {
              "id": "telefono-destino",
              "name": "telefono",
              "value": "={{ $json.telefono_veterinario }}",
              "type": "string"
            },
            { "id": "cliente-id-vacio", "name": "cliente_id", "value": "", "type": "string" }
          ]
        }
      }
    },
    {
      "id": "1611ca49-c810-47ef-9d7c-78fc1ebfb586",
      "name": "Notificar al Veterinario",
