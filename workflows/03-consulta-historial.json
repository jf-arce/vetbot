{
  "name": "03 - Consulta de Historial",
  "nodes": [
    {
      "id": "59197dc9-e4fd-47aa-8a46-418700a5f6d7",
      "name": "Recibir Consulta de Historial",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.2,
      "position": [0, 400],
      "parameters": {
        "inputSource": "workflowInputs",
        "workflowInputs": {
          "values": [
            { "name": "cliente_id", "type": "string" },
            { "name": "telefono", "type": "string" },
            { "name": "texto", "type": "string" }
          ]
        }
      }
    },
    {
      "id": "9d904bf6-a087-4022-ad7c-f3dcc911ffbc",
      "name": "Buscar Estado y Mascotas",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [224, 400],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT co.estado::text AS estado, co.contexto AS contexto, COALESCE((SELECT json_agg(json_build_object('id', m.id, 'nombre', m.nombre)) FROM mascotas m WHERE m.cliente_id = $1 AND m.estado = 'vivo'), '[]'::json) AS mascotas FROM (SELECT $1::uuid AS cliente_id) c LEFT JOIN conversaciones co ON co.cliente_id = c.cliente_id",
        "options": { "queryReplacement": "={{ [$json.cliente_id] }}" }
      },
      "credentials": { "postgres": { "name": "Supabase Postgres" } }
    },
    {
      "id": "6d91be60-8053-4538-bd66-c23c7a14a417",
      "name": "Resolver Mascota",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [448, 400],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\nconst info = $input.first().json;\nconst trigger = $('Recibir Consulta de Historial').first().json;\nconst mascotas = Array.isArray(info.mascotas) ? info.mascotas : [];\nconst texto = (trigger.texto || '').trim().toLowerCase();\n\nfunction normaliza(s) {\n  return (s || '').toString().trim().toLowerCase()\n    .normalize('NFD').replace(/[\\u0300-\\u036f]/g, '');\n}\n\nif (mascotas.length === 0) {\n  return [{ json: { accion: 'sin_mascotas', mensaje: 'No tenes mascotas registradas todavia. Cuando quieras dar de alta una, escribime.' } }];\n}\n\nif (info.estado === 'esperando_eleccion_mascota' && info.contexto && Array.isArray(info.contexto.mascotas) && info.contexto.mascotas.length > 0) {\n  const candidatas = info.contexto.mascotas;\n  const porNumero = parseInt(texto, 10);\n  let match = null;\n  if (!isNaN(porNumero) && porNumero >= 1 && porNumero <= candidatas.length) {\n    match = candidatas[porNumero - 1];\n  } else {\n    match = candidatas.find(function (m) { return normaliza(m.nombre) === normaliza(texto) || normaliza(texto).indexOf(normaliza(m.nombre)) !== -1; });\n  }\n  if (match) {\n    return [{ json: { accion: 'usar_mascota', mascota_id: match.id } }];\n  }\n  const lista = candidatas.map(function (m, i) { return (i + 1) + '. ' + m.nombre; }).join('\\n');\n  return [{ json: { accion: 'reintentar_eleccion', mensaje: 'No entendi cual mascota. Respondeme con el nombre o el numero:\\n' + lista, mascotas: candidatas } }];\n}\n\nif (mascotas.length === 1) {\n  return [{ json: { accion: 'usar_mascota', mascota_id: mascotas[0].id } }];\n}\n\nconst lista = mascotas.map(function (m, i) { return (i + 1) + '. ' + m.nombre; }).join('\\n');\nreturn [{ json: { accion: 'preguntar_cual', mensaje: 'Tenes mas de una mascota registrada. De cual queres el historial?\\n' + lista, mascotas: mascotas } }];\n"
      }
    },
    {
      "id": "0717f416-cf05-46b4-952e-3e5a1dcd4761",
      "name": "Accion Mascota",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.4,
      "position": [672, 384],
      "parameters": {
        "rules": {
          "values": [
            {
              "outputKey": "usar_mascota",
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
                "conditions": [{ "leftValue": "={{ $json.accion }}", "operator": { "type": "string", "operation": "equals" }, "rightValue": "usar_mascota" }],
                "combinator": "and"
              }
            },
            {
              "outputKey": "sin_mascotas",
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
                "conditions": [{ "leftValue": "={{ $json.accion }}", "operator": { "type": "string", "operation": "equals" }, "rightValue": "sin_mascotas" }],
                "combinator": "and"
              }
            }
          ]
        },
        "options": { "fallbackOutput": "extra", "renameFallbackOutput": "preguntar_o_reintentar" }
      }
    },
    {
      "id": "2a2be80c-8cec-4b6b-8073-435a56f05d7a",
      "name": "Buscar Historial Clinico",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [896, 112],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT fecha, tipo::text AS tipo, diagnostico, tratamiento_indicado, veterinario, notas FROM historias_clinicas WHERE mascota_id = $1 ORDER BY fecha DESC LIMIT 10",
        "options": { "queryReplacement": "={{ [$json.mascota_id] }}" }
      },
      "credentials": { "postgres": { "name": "Supabase Postgres" } }
    },
    {
      "id": "113678f2-ecc7-4a17-bf6c-91925f8dd04f",
      "name": "Redactar Historial",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [1120, 0],
      "parameters": {
        "promptType": "define",
        "text": "={{ 'Redacta en espanol rioplatense, en un mensaje corto y calido de WhatsApp para el dueño de la mascota, un resumen legible del siguiente historial clinico (JSON, mas reciente primero). Si esta vacio, decile amablemente que todavia no hay registros cargados.\\n\\n' + JSON.stringify($input.all().map(function(i){return i.json;})) }}",
        "hasOutputParser": false,
        "options": { "systemMessage": "Sos el asistente de una veterinaria. Redactas resumenes de historia clinica claros, breves y calidos para el dueño de la mascota, sin jerga medica innecesaria." }
      },
      "executeOnce": true
    },
