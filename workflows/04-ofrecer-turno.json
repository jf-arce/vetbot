      "parameters": {
        "jsCode": "// ── Datos que vienen de los nodos anteriores ──────────────────\nconst horarios = $('Leer horarios_atencion').all().map(i => i.json);\nconst excepciones = $('Leer excepciones_horario').all().map(i => i.json);\nconst config = $('Leer configuracion_general').all().map(i => i.json);\nconst ocupados = $('Consultar Calendar').first().json.calendars;\n\n// ── Leer configuración ────────────────────────────────────────\nconst duracion = parseInt(config.find(c => c.clave === 'duracion_turno_minutos').valor);\nconst diasAnticipacion = parseInt(config.find(c => c.clave === 'dias_anticipacion').valor);\nconst turnosAMostrar = parseInt(config.find(c => c.clave === 'turnos_a_mostrar').valor);\n\n// ── Días de la semana ─────────────────────────────────────────\nconst DIAS = ['domingo','lunes','martes','miercoles','jueves','viernes','sabado'];\n\n// ── Buscar slots libres ───────────────────────────────────────\nconst slots = [];\nconst ahora = new Date();\n\nfor (let d = 0; d < diasAnticipacion; d++) {\n  const fecha = new Date(ahora);\n  fecha.setDate(ahora.getDate() + d);\n  const diaNombre = DIAS[fecha.getDay()];\n  const fechaStr = fecha.toISOString().split('T')[0]; // \"2026-08-18\"\n\n  // ¿Hay excepción para este día?\n  const excepcion = excepciones.find(e => e.fecha === fechaStr);\n  if (excepcion && excepcion.cerrado) continue; // día cerrado, skip\n\n  // Horario base del día\n  const horario = horarios.find(h => h.dia_semana === diaNombre && h.activo);\n  if (!horario) continue; // día no laborable, skip\n\n  // Horario de apertura y cierre\n  const apertura = horario.hora_apertura.substring(0, 5); // \"09:00\"\n  const cierre = horario.hora_cierre.substring(0, 5);     // \"18:00\"\n\n  // Generar todos los slots del día\n  const [hAp, mAp] = apertura.split(':').map(Number);\n  const [hCi, mCi] = cierre.split(':').map(Number);\n\n  let slotInicio = new Date(fecha);\n  slotInicio.setHours(hAp, mAp, 0, 0);\n  const slotFin = new Date(fecha);\n  slotFin.setHours(hCi, mCi, 0, 0);\n\n  while (slotInicio < slotFin) {\n    const slotFinActual = new Date(slotInicio.getTime() + duracion * 60000);\n\n    // ¿El slot ya pasó?\n    if (slotInicio <= ahora) {\n      slotInicio = slotFinActual;\n      continue;\n    }\n\n    // ¿Está ocupado en Calendar?\n    const estaOcupado = Object.values(ocupados).some(cal =>\n      cal.busy.some(b => {\n        const bStart = new Date(b.start);\n        const bEnd = new Date(b.end);\n        return slotInicio < bEnd && slotFinActual > bStart;\n      })\n    );\n\n    if (!estaOcupado) {\n      slots.push({\n        inicio: slotInicio.toISOString(),\n        fin: slotFinActual.toISOString(),\n        label: slotInicio.toLocaleString('es-AR', {\n          weekday: 'long', day: 'numeric', month: 'long',\n          hour: '2-digit', minute: '2-digit'\n        })\n      });\n    }\n\n    slotInicio = slotFinActual;\n  }\n}\n\n// ── Tomar los primeros N slots ────────────────────────────────\nconst resultado = slots.slice(0, turnosAMostrar);\n\nreturn resultado.map(s => ({ json: s }));"
      },
