{
  "name": "00 - Enviar WhatsApp",
  "nodes": [
    {
      "id": "52600d4c-ad6c-495d-a459-0deb3d770059",
      "name": "Recibir Datos de Envio",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "parameters": {
        "inputSource": "workflowInputs",
        "workflowInputs": {
          "values": [
            { "name": "telefono", "type": "string" },
            { "name": "texto", "type": "string" },
            { "name": "cliente_id", "type": "string" }
          ]
        }
      }
    },
    {
      "id": "c64a7df8-32e2-49e9-aabf-9d3710f6706a",
      "name": "Config Evolution",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [224, 0],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "evolution-base-url",
              "name": "evolution_base_url",
              "value": "https://corners-jungle-primarily-sagem.trycloudflare.com",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "95546be4-d679-4306-98ac-b5e54126e1a8",
      "name": "Enviar por Evolution",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [448, 0],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.evolution_base_url }}/message/sendText/vetbot",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpTemplatedCustomAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ { \"number\": $json.telefono, \"text\": $json.texto } }}",
        "options": {}
      },
      "credentials": {
        "httpTemplatedCustomAuth": { "name": "Evolution API" }
      }
    },
    {
      "id": "f9279d2c-9ac6-49ea-8a3d-2baf92759d44",
      "name": "Insertar Mensaje Saliente",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [672, 0],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO mensajes (cliente_id, direccion, contenido, telefono) VALUES ($1, 'saliente', $2, $3)",
        "options": {
          "queryReplacement": "={{ [$('Config Evolution').item.json.cliente_id || null, $('Config Evolution').item.json.texto, $('Config Evolution').item.json.telefono] }}"
        }
      },
      "credentials": {
        "postgres": { "name": "Supabase Postgres" }
      }
    }
  ],
  "connections": {
    "Recibir Datos de Envio": { "main": [[{ "node": "Config Evolution", "type": "main", "index": 0 }]] },
    "Config Evolution": { "main": [[{ "node": "Enviar por Evolution", "type": "main", "index": 0 }]] },
    "Enviar por Evolution": { "main": [[{ "node": "Insertar Mensaje Saliente", "type": "main", "index": 0 }]] }
  },
  "pinData": {},
  "settings": { "executionOrder": "v1" },
  "meta": {
    "n8nWorkflowId": "dXu7S5atkZfbcZrw",
    "instanceUrl": "https://josefranciscoarce.app.n8n.cloud"
  }
}
