# Copiar a `.env` y completar. Nunca commitear el `.env` real.
# Supabase → Project Settings → API

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Usar SIEMPRE la key `anon` (pública). La `service_role` no va en el frontend:
# el panel corre en el navegador y la seguridad real la dan las policies de RLS.
VITE_SUPABASE_ANON_KEY=

# Webhooks de n8n — para las acciones que además tocan un servicio externo
# (cancelar turno también borra el evento de Google Calendar, reenviar
# recordatorio manda un WhatsApp real). Los expone Dev 2.
VITE_N8N_WEBHOOK_CANCELAR_TURNO=
VITE_N8N_WEBHOOK_REENVIAR_RECORDATORIO=
